{
  "name": "ttokttok",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @ttokttok/client && npm run build --workspace @ttokttok/admin",
    "start": "node scripts/dev.mjs --production",
    "lint": "eslint apps packages scripts e2e tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "covers": "node --env-file=.env scripts/generate-covers.mjs",
    "epubs:refresh": "node --env-file=.env scripts/refresh-epubs.mjs",
    "wikisource:sync": "node --env-file=.env scripts/sync-wikisource-works.mjs",
    "admin:create": "node --env-file=.env scripts/create-admin.mjs",
    "dev:client": "npm run dev --workspace @ttokttok/client",
    "dev:admin": "npm run dev --workspace @ttokttok/admin",
    "typecheck": "node scripts/typecheck.mjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:integration": "node --conditions=react-server --import tsx --test tests/live-db/*.test.ts",
    "start:client": "npm run start --workspace @ttokttok/client",
    "start:admin": "npm run start --workspace @ttokttok/admin",
    "build:client": "npm run build --workspace @ttokttok/client",
    "build:admin": "npm run build --workspace @ttokttok/admin",
    "test:db": "node scripts/test-db.mjs",
    "test:seed": "node scripts/seed-test.mjs",
    "test:build": "node scripts/build-test.mjs",
    "db:types": "node scripts/test-db.mjs --types"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@ttokttok/content": "*",
    "@ttokttok/database": "*",
    "@ttokttok/shared": "*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "shadcn": "^4.19.0",
    "supabase": "^2.105.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
