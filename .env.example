# =============================================================
# 똑똑 (Ttokttok) 환경변수 템플릿
# -------------------------------------------------------------
# 사용법:
#   1. 이 파일은 루트 스크립트용 .env 템플릿이다
#   2. 앱 실행은 apps/client·apps/admin의 .env.example을 각각 .env.local로 복사
#   3. .env.local 은 절대 커밋하지 않기 (.gitignore 에 포함)
#   4. Vercel 배포 변수와 앱 간 주소는 docs/monorepo-deployment.md 참고
# =============================================================

# --- Supabase ------------------------------------------------
# Supabase 대시보드 > Project Settings > API 에서 확인

# 프로젝트 URL (예: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon (public) key — 브라우저에 노출되는 키. RLS가 보안을 담당
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — 서버 전용. RLS를 우회하므로 절대 클라이언트에 노출 금지
# 용도: 어드민 API, EPUB signed URL 발급, 카운터 증감 RPC 등
SUPABASE_SERVICE_ROLE_KEY=

# --- 사이트 --------------------------------------------------
# 배포 도메인. OG 메타/딥링크(/p/[postId]) 절대경로 생성에 사용
# 로컬: http://localhost:3000 / 배포: https://ttokttok.vercel.app 등
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 어드민 --------------------------------------------------
# 최초 관리자 계정 이메일 (시드 스크립트에서 role='admin' 부여용, 선택)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =============================================================
# 참고: 여기에 넣지 않는 것들
# -------------------------------------------------------------
# - Google/Kakao OAuth 클라이언트 ID/Secret:
#   앱 코드가 아니라 Supabase 대시보드에 등록한다.
#   (Authentication > Providers > Google / Kakao)
# - Supabase DB 비밀번호: 앱에서 직접 DB 접속하지 않으므로 불필요
#   (마이그레이션은 Supabase CLI가 별도 로그인으로 처리)
# =============================================================

KAKAO_REST_API_KEY=
KAKAO_SECRET_KEY=